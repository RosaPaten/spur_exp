##############################Generates Flagged Schur Polynomials
Sym = SymmetricFunctions(QQ)
H = Sym.homogeneous()
R=PolynomialRing(QQ, 3,'x')
x=R.gens()
    
def f(l,m,b,i,j):
  if l[i]-m[j]-i+j>0:
    if b[i]>1:
      return H[l[i]-m[j]-(i)+(j)].expand(b[i])
    else:
      return x[0]^(l[i]-m[j]-(i)+(j))
  if l[i]-m[j]-i+j==0:
    return 1
  else:
    return 0

def s(l,m,b):
  N=len(l)
  A=matrix(N,N,lambda i, j: f(l,m,b,i,j))
  return A.determinant()

def ceiling(l,m):
  n=[]
  L=len(l)
  for i in range(L):
    n.append(((l[i]+m[i])/2).ceil())
  return n

def floor(l,m):
  n=[]
  L=len(l)
  for i in range(L):
    n.append(((l[i]+m[i])/2).floor())
  return n

def minn(l,m):
  n=[]
  L=len(l)
  for i in range(L):
    n.append(min(l[i],m[i]))
  return n

def maxx(l,m):
  n=[]
  L=len(l)
  for i in range(L):
    n.append(max(l[i],m[i]))
  return n
    


#writes difference in key basis
k = KeyPolynomials(R, Compositions())

def check(l_1,m_1,l_2,m_2,b):
  c1=ceiling(l_1,l_2)
  c2=ceiling(m_1,m_2)
  f1=floor(l_1,l_2)
  f2=floor(m_1,m_2)
  poly=s(c1,c2,b)*s(f1,f2,b)-s(l_1,m_1,b)*s(l_2,m_2,b)
  poly=k.from_polynomial(poly)
  coef=poly.coefficients()
  for i in coef:
    if i<0:
      return False
      
  return True

