##############################Generates Flagged Schur Polynomials
Sym = SymmetricFunctions(QQ)
H = Sym.homogeneous()
R=PolynomialRing(QQ, 4,'x')
x=R.gens()
jakob=SchubertPolynomialRing(QQ)
    
def f(l,m,b,i,j):
  if l[i]-m[j]-i+j>0:
    if b[i]>1:
      return H[l[i]-m[j]-(i)+(j)].expand(b[i])
    else:
      return x[0]^(l[i]-m[j]-(i)+(j))
  if l[i]-m[j]-i+j==0:
    return 1
  else:
    return 0

def s(l,m,b):
  N=len(l)
  A=matrix(N,N,lambda i, j: f(l,m,b,i,j))
  return A.determinant()

    
