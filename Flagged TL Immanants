def f(l,m,b,i,j):
  if l[i]-m[j]>0:
    if b[i]>1:
      return H[l[i]-m[j]].expand(b[i])
    else:
      return x[0]^(l[i]-m[j])
  if l[i]-m[j]==0:
      return 1
  else:
      return 0

def g(l,m,i,j):
    if l[i]-m[j]>0:
       return H[l[i]-m[j]].expand(3)
    elif l[i]-m[j]==0:
      return 1
    else:
      return 0
def genSchur(l,m):
  N=len(l)
  A=matrix(N,N,lambda i, j: g(l,m,i,j))
  return A    

def gen(l,m,b):
  N=len(l)
  A=matrix(N,N,lambda i, j: f(l,m,b,i,j))
  return A

def reverse(l):
    L=[]
    for i in range(len(l)):
        L.append(l[len(l)-i-1])
    return L

