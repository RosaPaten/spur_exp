S=SymmetricGroupAlgebra(QQ, 4)
G=SymmetricGroup(4)
s=G.simple_reflections()
Alg=TemperleyLiebAlgebra(4,2,QQ)

def genTL(i):
    d=[]
    d.append([i,i+1])
    d.append([-i,-(i+1)])
    return Alg(d)

def gen2(v):
    prod=1
    red=v.reduced_word()
    #red=reverse(red)
    for i in red:
        prod=genTL(i)*prod
    return prod

#iterates through red, computes element prod (t_i-1) in the group algebra
#then iterates through product to find coefficient on T_w
#input w just as a list and v as an element of G
def F(w,v):
  red=v.reduced_word()
  #red=reverse(red)
  prod=1
  for i in red:
    prod=(genTL(i)-1)*prod
  if type(prod)==Integer:
    if S(w)==1:
        return prod
    else:
        return 0
  p=gen2(G(w))
  D=prod._monomial_coefficients
  for key in D:
      if Alg(key) == p:
          return D.get(key)
  return 0

def Imm(w,X,n):
  imm=0
  for v in G:
    prod=F(w,v)
    for i in range(n):
      prod=prod*X[i][v(i+1)-1]
    imm=imm+prod
  return imm

