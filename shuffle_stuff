####code to test whether algorithms to go from shuffle tableaux -> tableaux are correct/commute with crystal operators
#tableau use None to indicate emptyspace

def listify(T):
  T=list(T)
  for j in range(len(T)):
    T[j]=list(T[j])
  return T    

#returns tableau without None values
def clean(T):
  T=listify(T)
  U=[]
  for i in range(len(T)):
    l=[]
    for j in range(len(T[i])):
      if T[i][j]!=None:
        l.append(T[i][j])
    U.append(l)
  return U
  

#lowering operators: input is a tableau T, integer i
def f(i,T):
  w=T.to_word()
  word=[]
  for j in w:
    word.append(j)
  l=len(word)
  #pairs parentheses
  for j in range(l):
    sgn=1
    if word[j]==i+1:
      for k in range(j,l):
        if word[k]==i and sgn==1:
          word[k]=-1
          word[j]=-1
          sgn=-1
  #finds rightmost unpaired i
  index=-1
  for j in range(l):
    if word[j]==i:
      index=j
  if index==-1:
    return 0
  count=0
  #converts T to list
  T=listify(T)
  T.reverse()
  for j in range(len(T)):
    for k in range(len(T[j])):
      if count==index:
        T[j][k]=i+1
      count=count+1
  T.reverse()
  return Tableau(T)

#lowering operators: input is a tableau T which we treat as a shuffle tableau
def F(i,T):
  #first cleans out i-paired is
  T=listify(T)
  for j in range(len(T)-2):
    for k in range(min(len(T[j]),len(T[j+2]))):
      if T[j][k]==i and T[j+2][k]==i+1:
        T[j][k]=[i]
        T[j+2][k]=[i+1]
  T=Tableau(T)
  T=f(i,T)
  T=listify(T)
  for j in range(len(T)):
    for k in range(len(T[j])):
      if type(T[j][k])==list:
        T[j][k]=T[j][k][0]
  return Tableau(T)



#function to go from shuffle tableau -> tableau. multiplies rows of shuffle tableau. inputs tableau as a tableau
def phi(T):
  T=clean(T)
  t=Tableau([])
  for i in range(len(T)):
    t_i=Tableau([list(T[i])])
    t=t_i.bump_multiply(t)
  return t

T=Tableau([[None,1],[None,1],[1,2]])
print(f(1,phi(T)))
print(phi(F(1,T)))




    



