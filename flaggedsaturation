import sage.combinat.permutation as permutation

###generates flagged Jacobi-Trudi matrix
Sym = SymmetricFunctions(QQ)
H = Sym.homogeneous()
R=PolynomialRing(QQ, 4,'x')
k = KeyPolynomials(R)
SC = Sym.s()
x=R.gens()

G=SymmetricGroup(5)
s=G.simple_reflections()


def w(n):
  prod=G.identity()
  for i in range(1,n):
    prod=s[i]*prod
  return prod
  
#generates longest permutation in Sym(n)  
def longest(n):
  prod=G.identity()
  for i in range(1,n+1):
    prod=prod*w(i)
  return prod
    
#makes f symmetric
def T(f,n):
  f=k.from_polynomial(f)
  w=longest(n)
  w=w.reduced_word()
  return f.pi(w)

def f(l,m,b,i,j):
  if l[i]-m[j]>0:
    if b[i]>1:
      return H[l[i]-m[j]].expand(b[i])
    else:
      return x[0]^(l[i]-m[j])
  if l[i]-m[j]==0:
      return 1
  else:
      return 0

def g(l,m,i,j):
    if l[i]-m[j]>0:
       return H[l[i]-m[j]].expand(3)
    elif l[i]-m[j]==0:
      return 1
    else:
      return 0
      
#generates Schur polynomial
def genSchur(l,m):
  N=len(l)
  A=matrix(N,N,lambda i, j: g(l,m,i,j))
  return A.determinant()    

#generates flagged Schur polynomial
def gen(l,m,b):
  N=len(l)
  A=matrix(N,N,lambda i, j: f(l,m,b,i,j))
  return A.determinant()

#finds coefficient of schur polynomial
def c(nu,l1,m1,l2,m2,b,scale):
  L1=[]
  M1=[]
  L2=[]
  M2=[]
  N=[]
  for i in l1:
    L1.append(scale*i)
  for i in m1:
    M1.append(scale*i)
  for i in l1:
    L2.append(scale*i)
  for i in m2:
    M2.append(scale*i)
  for i in nu:
    N.append(scale*i)
  f=gen(L1,M1,b)*gen(L2,M2,b)
  f=SC.from_polynomial(len(l1))
  return f.coefficient(N)

def keyc(a,l1,m1,l2,m2,b,scale):
  L1=[]
  M1=[]
  L2=[]
  M2=[]
  A=[]
  for i in l1:
    L1.append(scale*i)
  for i in m1:
    M1.append(scale*i)
  for i in l1:
    L2.append(scale*i)
  for i in m2:
    M2.append(scale*i)
  for i in a:
    A.append(scale*i)
  f=gen(L1,M1,b)*gen(L2,M2,b)
  f=k.from_polynomial(f)
  f.coefficient(A)
  
  
  

